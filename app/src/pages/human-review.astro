---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Optional human advice" description="Optional local source-grounded advice and override workspace.">
  <section class="page-intro human-intro">
    <div class="eyebrow">Local editorial workspace</div>
    <h1>Add advice or an explicit override when useful.</h1>
    <p>Codex CLI is the default semantic adjudicator. This optional workspace exposes exact transcript evidence when a person wants to add editorial advice or deliberately override a queued decision; ordinary processing does not depend on it.</p>
  </section>

  <section class="review-guide" aria-labelledby="review-guide-title">
    <div>
      <div class="section-kicker">Start here</div>
      <h2 id="review-guide-title">Three steps per card</h2>
      <p>Highlighted transcript rows are the supporting evidence. Nearby rows provide context only.</p>
    </div>
    <ol>
      <li><strong>Understand the claim.</strong><span>Decide whether the definition says only what the speaker supports.</span></li>
      <li><strong>Check the evidence.</strong><span>Read the highlighted lines and the nearby context before deciding.</span></li>
      <li><strong>Record the outcome.</strong><span>Choose an existing concept, create a distinct one, reject it, or keep it for later with a useful note.</span></li>
    </ol>
  </section>

  <section class="review-safety" id="review-safety" aria-live="polite">
    <div><strong id="safety-title">Checking processor state…</strong><span id="safety-copy">Decisions are disabled until the local monitor confirms that automated processing is paused.</span></div>
    <button id="pause-loop" type="button" hidden>Pause automation</button>
  </section>

  <section class="batch-heading">
    <div><div class="section-kicker">Current batch</div><h2>Work from top to bottom</h2><p>Review the five cards shown below, then load the next batch.</p></div>
    <div class="batch-actions"><span id="queue-count">Loading queue…</span><button id="load-next" class="secondary" type="button">Load next five</button></div>
  </section>

  <div id="review-message" class="review-message" role="status" hidden></div>
  <section id="review-items" class="human-review-items" aria-live="polite"><p>Loading source-backed candidates…</p></section>

  <section class="decision-reference" aria-labelledby="decision-reference-title">
    <div class="section-kicker">Decision guide</div>
    <h2 id="decision-reference-title">What each choice does</h2>
    <div class="decision-reference-grid">
      <div><strong>Accept into concept</strong><span>Adds this evidence to the selected reviewed concept.</span></div>
      <div><strong>Create new concept</strong><span>Creates a new reviewed article after you check for duplicates.</span></div>
      <div><strong>Reject candidate</strong><span>Closes the item because the claim is not supported.</span></div>
      <div><strong>Keep for later</strong><span>Saves your note without resolving the item.</span></div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  const monitor = 'http://127.0.0.1:4322';
  const itemsRoot = document.querySelector('#review-items');
  const count = document.querySelector('#queue-count');
  const message = document.querySelector('#review-message');
  const pauseButton = document.querySelector('#pause-loop');
  let canWrite = false;
  let concepts = [];

  const escapeHtml = (value) => String(value ?? '').replace(/[&<>'"]/g, (character) => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[character]));
  const seconds = (value) => `${(Number(value || 0) / 1000).toFixed(1)}s`;
  async function api(path, options) {
    const response = await fetch(`${monitor}${path}`, options);
    const result = await response.json().catch(() => ({error: response.statusText}));
    if (!response.ok) throw new Error(result.error || 'The local monitor rejected the request.');
    return result;
  }
  function showMessage(text, mode = '') {
    message.hidden = false;
    message.className = `review-message ${mode}`;
    message.textContent = text;
  }
  function updateControls() {
    document.querySelectorAll('.decision-button').forEach((button) => { button.disabled = !canWrite; });
  }
  async function refreshSafety() {
    const title = document.querySelector('#safety-title');
    const copy = document.querySelector('#safety-copy');
    try {
      const state = await api('/api/status');
      canWrite = !state.running && !state.activeRun;
      if (state.activeRun) {
        title.textContent = 'An automated cycle is active';
        copy.textContent = 'Wait for the current cycle to finish. Do not interrupt it to save a review decision.';
        pauseButton.hidden = true;
      } else if (state.running) {
        title.textContent = 'Pause automation before editing';
        copy.textContent = 'The loop is between cycles. Pause it now so a new cycle cannot start while canonical files are being updated.';
        pauseButton.hidden = false;
      } else {
        title.textContent = 'Editing is safe';
        copy.textContent = 'The processor loop is paused and no cycle is active. Resume it from the Processor monitor after this review session.';
        pauseButton.hidden = true;
      }
    } catch (error) {
      canWrite = false;
      title.textContent = 'Processor monitor unavailable';
      copy.textContent = 'Start the local monitor on port 4322. Reading and writing this private queue requires that service.';
      pauseButton.hidden = true;
    }
    updateControls();
  }
  function conceptOptions(selected) {
    const knownSelection = concepts.some((concept) => concept.id === selected);
    return `<option value="" ${knownSelection ? '' : 'selected'}>Choose an existing reviewed concept…</option>` + concepts.map((concept) => `<option value="${escapeHtml(concept.id)}" ${concept.id === selected ? 'selected' : ''}>${escapeHtml(concept.label)} — ${escapeHtml(concept.id)}</option>`).join('');
  }
  function renderItem(item, index) {
    const candidate = item.candidate || {};
    const evidence = item.selected_evidence || {};
    const boundary = item.boundary;
    const suggested = candidate.matched_concept_id || '';
    const context = item.context_segments.map((segment) => `<li class="${segment.cited ? 'cited' : 'context'}"><span>${seconds(segment.start_ms)}</span><p>${escapeHtml(segment.text)}</p><small>${segment.cited ? 'Cited evidence' : 'Nearby context'}</small></li>`).join('');
    const flags = boundary?.flags?.length ? boundary.flags.map((flag) => `<span>${escapeHtml(flag.replaceAll('_', ' '))}</span>`).join('') : '<span class="clear">complete caption unit</span>';
    return `<article class="human-review-card" data-video="${escapeHtml(item.video_id)}" data-candidate="${escapeHtml(item.candidate_id)}" data-hash="${escapeHtml(item.candidate_hash)}">
      <header class="card-header"><div class="card-ident"><span class="item-number">${String(index + 1).padStart(2, '0')}</span><div><strong>Candidate ${String(index + 1).padStart(2, '0')}</strong><span class="candidate-type">${escapeHtml(item.source_id)} · ${escapeHtml(candidate.concept_type || 'concept')}</span></div></div><div class="card-status"><strong>Optional advice available</strong><span>${Math.round(Number(candidate.confidence || 0) * 100)}% confidence · ${escapeHtml(candidate.resolution || 'unknown')}</span></div></header>
      <section class="review-step claim-section"><div class="step-heading"><span>1</span><div><strong>Understand the claim</strong><small>Does this definition accurately describe what the speaker said?</small></div></div><h3>${escapeHtml(candidate.canonical_label)}</h3><p class="definition">${escapeHtml(candidate.definition)}</p><div class="review-reasons"><dl><dt>Why automatic checks stopped</dt><dd>${escapeHtml(item.adjudication_reason || item.review_notes)}</dd><dt>Evidence rationale</dt><dd>${escapeHtml(evidence.reason || 'No rationale supplied.')}</dd>${candidate.uncertainty?.length ? `<dt>Recorded uncertainty</dt><dd>${escapeHtml(candidate.uncertainty.join(' · '))}</dd>` : ''}</dl></div></section>
      <section class="review-step evidence-section"><div class="step-heading"><span>2</span><div><strong>Check the evidence</strong><small>Read the highlighted lines first, then use nearby lines for context.</small></div></div><div class="source-summary"><div class="source-details"><strong>Source video</strong><a href="${escapeHtml(item.video?.url || `https://www.youtube.com/watch?v=${item.video_id}`)}" target="_blank" rel="noreferrer">${escapeHtml(item.video?.title || item.video_id)}</a><span>${escapeHtml(item.video?.channel_name || 'Channel unavailable')}</span></div><div class="source-window"><strong>${boundary ? `${seconds(boundary.start_ms)}–${seconds(boundary.end_ms)}` : 'No valid cited span'}</strong><div class="boundary-flags">${flags}</div></div><p>${escapeHtml(boundary?.reason || 'The source segments could not be resolved. Do not accept this item.')}</p></div><section class="transcript-panel"><div><strong>Transcript context</strong><span>Highlighted rows are the exact citation.</span></div><ol>${context || '<li>No normalized transcript context is available.</li>'}</ol></section></section>
      <section class="review-step decision-section"><div class="step-heading"><span>3</span><div><strong>Record the outcome</strong><small>Choose one action and explain enough that another editor can follow your reasoning.</small></div></div><form class="decision-form"><label>Existing concept target<select name="target">${conceptOptions(suggested)}</select><small>Use the suggested match only if this is the same durable concept. This is ignored when creating a new concept.</small></label><label>Reviewer note<textarea name="notes" rows="3" minlength="12" placeholder="What does the evidence support, or why does it fail?" required></textarea></label><fieldset class="confirmations"><legend>Before accepting</legend><label><input name="confirm_source" type="checkbox"> I confirmed the highlighted transcript supports the candidate definition.</label><label><input name="confirm_concept" type="checkbox"> I confirmed the existing mapping, or checked that a new concept is distinct.</label></fieldset><div class="decision-actions"><button class="decision-button accept" type="button" data-action="accept_existing">Accept into concept</button><button class="decision-button accept-new" type="button" data-action="accept_new">Create new concept</button><button class="decision-button reject" type="button" data-action="reject">Reject candidate</button><button class="decision-button keep" type="button" data-action="keep">Keep for later</button></div></form>
    </article>`;
  }
  async function loadBatch() {
    itemsRoot.innerHTML = '<p>Loading source-backed candidates…</p>';
    try {
      const data = await api('/api/human-review?limit=5&offset=0');
      concepts = data.concepts || [];
      count.textContent = `${data.items.length} shown · ${data.total.toLocaleString()} waiting`;
      itemsRoot.innerHTML = data.items.length ? data.items.map(renderItem).join('') : '<div class="empty-state"><strong>No advisory candidates remain.</strong><span>Codex has no deferred work available for an optional annotation or override.</span></div>';
      updateControls();
    } catch (error) {
      count.textContent = 'Queue unavailable';
      itemsRoot.innerHTML = `<div class="empty-state error"><strong>Could not load the private queue.</strong><span>${escapeHtml(error.message)}</span></div>`;
    }
  }
  itemsRoot.addEventListener('click', async (event) => {
    const button = event.target.closest('.decision-button');
    if (!button) return;
    const card = button.closest('.human-review-card');
    const form = card.querySelector('form');
    const notes = form.elements.notes.value.trim();
    if (notes.length < 12) { showMessage('Add a specific review note of at least 12 characters.', 'error'); form.elements.notes.focus(); return; }
    const action = button.dataset.action;
    if (action.startsWith('accept_') && (!form.elements.confirm_source.checked || !form.elements.confirm_concept.checked)) { showMessage('Confirm both the transcript support and concept decision before accepting.', 'error'); return; }
    card.querySelectorAll('button').forEach((value) => { value.disabled = true; });
    try {
      const result = await api('/api/human-review/decision', {method:'POST', headers:{'content-type':'application/json'}, body:JSON.stringify({video_id:card.dataset.video,candidate_id:card.dataset.candidate,candidate_hash:card.dataset.hash,action,target_concept_id:form.elements.target.value,notes,confirm_source:form.elements.confirm_source.checked,confirm_concept:form.elements.confirm_concept.checked})});
      card.classList.add('resolved');
      form.innerHTML = `<div class="resolved-message"><strong>${escapeHtml(result.decision)}</strong><span>${escapeHtml(result.message)}</span></div>`;
      showMessage(result.message, 'success');
    } catch (error) {
      showMessage(error.message, 'error');
      card.querySelectorAll('button').forEach((value) => { value.disabled = !canWrite; });
    }
  });
  pauseButton.addEventListener('click', async () => { try { await api('/api/stop', {method:'POST'}); await refreshSafety(); showMessage('Automation paused. You can now save review decisions.', 'success'); } catch (error) { showMessage(error.message, 'error'); } });
  document.querySelector('#load-next').addEventListener('click', loadBatch);
  Promise.all([refreshSafety(), loadBatch()]);
  setInterval(refreshSafety, 5000);
</script>

<style is:global>
  .human-intro { max-width:940px; }
  .review-guide { margin:2rem 0; padding:1.5rem; border:1px solid var(--line); background:var(--paper); display:grid; grid-template-columns:minmax(190px,.55fr) 1.45fr; gap:2rem; }
  .review-guide h2,.batch-heading h2 { margin:.25rem 0 0; }
  .review-guide ol { margin:0; padding:0; list-style:none; counter-reset:steps; display:grid; gap:1rem; }
  .review-guide li { counter-increment:steps; display:grid; grid-template-columns:2rem 1fr; column-gap:.8rem; }
  .review-guide li::before { content:counter(steps); grid-row:1/3; width:2rem; height:2rem; display:grid; place-items:center; border-radius:50%; background:var(--ink); color:var(--paper); font-weight:700; }
  .review-guide li span { color:var(--muted); font-size:.86rem; line-height:1.5; }
  .review-safety { padding:1rem 1.2rem; border:1px solid #c8963f; border-left:5px solid #c8963f; background:#fff8e8; display:flex; align-items:center; justify-content:space-between; gap:1rem; }
  .review-safety div { display:grid; gap:.25rem; }.review-safety span { color:#675b45; font-size:.86rem; }
  button,select,textarea { font:inherit; } button { cursor:pointer; padding:.68rem .9rem; border:1px solid var(--ink); background:var(--ink); color:white; font-weight:700; } button.secondary,.keep { color:var(--ink); background:transparent; } button:disabled { opacity:.4; cursor:not-allowed; }
  .batch-heading { margin:2.5rem 0 1rem; display:flex; justify-content:space-between; align-items:end; gap:1rem; }.batch-actions { display:flex; align-items:center; gap:1rem; color:var(--muted); font-size:.84rem; }
  .review-message { position:sticky; top:.5rem; z-index:3; padding:.8rem 1rem; margin-bottom:1rem; border:1px solid var(--line); background:var(--paper); }.review-message.error { border-color:#a44; color:#842d2d; }.review-message.success { border-color:#397a58; color:#245c40; }
  .human-review-items { display:grid; gap:1.5rem; }.human-review-card { border:1px solid var(--line); background:var(--paper); box-shadow:0 12px 35px rgba(34,38,31,.06); }.human-review-card>header { padding:.9rem 1.15rem; border-bottom:1px solid var(--line); display:flex; justify-content:space-between; color:var(--muted); font-size:.78rem; }.item-number { font-weight:800; color:var(--ink); margin-right:.8rem; }.candidate-type { text-transform:uppercase; letter-spacing:.08em; }
  .candidate-grid { display:grid; grid-template-columns:1.5fr .7fr; gap:1.5rem; padding:1.35rem; }.candidate-grid h3 { margin:0; font-size:1.45rem; }.definition { font-size:1rem; line-height:1.6; }.candidate-grid dl { display:grid; grid-template-columns:145px 1fr; gap:.6rem 1rem; margin:1.2rem 0 0; font-size:.84rem; }.candidate-grid dt { font-weight:750; }.candidate-grid dd { margin:0; color:var(--muted); line-height:1.5; }.candidate-grid aside { padding:1rem; background:#f4f2ea; display:flex; flex-direction:column; align-items:start; gap:.4rem; font-size:.84rem; }.candidate-grid aside a { font-weight:700; color:var(--ink); }.candidate-grid aside p { color:var(--muted); line-height:1.45; margin:.4rem 0 0; }.boundary-flags { display:flex; flex-wrap:wrap; gap:.35rem; margin-top:.5rem; }.boundary-flags span { padding:.2rem .4rem; background:#f3dfb8; color:#674b20; font-size:.7rem; }.boundary-flags .clear { background:#dcecdf; color:#285d3d; }
  .transcript-panel { margin:0 1.35rem; border:1px solid var(--line); }.transcript-panel>div { padding:.75rem 1rem; display:flex; justify-content:space-between; gap:1rem; background:#f4f2ea; font-size:.8rem; }.transcript-panel>div span { color:var(--muted); }.transcript-panel ol { list-style:none; margin:0; padding:0; }.transcript-panel li { display:grid; grid-template-columns:4.5rem 1fr 6.5rem; gap:.8rem; padding:.65rem 1rem; border-top:1px solid var(--line); align-items:start; }.transcript-panel li.cited { background:#fff5cf; border-left:4px solid #c8963f; }.transcript-panel li span,.transcript-panel li small { color:var(--muted); font:11px/1.5 ui-monospace,monospace; }.transcript-panel li p { margin:0; line-height:1.45; font-size:.88rem; }
  .decision-form { padding:1.35rem; display:grid; grid-template-columns:1fr 1fr; gap:1rem 1.5rem; }.decision-form>label { display:grid; gap:.4rem; font-weight:700; font-size:.86rem; }.decision-form small { color:var(--muted); font-weight:400; line-height:1.4; }.decision-form select,.decision-form textarea { width:100%; box-sizing:border-box; border:1px solid var(--line); background:white; color:var(--ink); padding:.65rem; }.confirmations { grid-column:1/-1; display:grid; gap:.5rem; padding:.8rem; background:#f4f2ea; font-size:.84rem; }.decision-actions { grid-column:1/-1; display:flex; gap:.7rem; flex-wrap:wrap; }.accept-new { background:#2f6f8e; border-color:#2f6f8e; }.reject { background:#853d38; border-color:#853d38; }.resolved { opacity:.72; }.resolved-message { grid-column:1/-1; display:flex; gap:.6rem; align-items:baseline; color:#285d3d; }.empty-state { padding:2rem; border:1px dashed var(--line); display:grid; gap:.4rem; }.empty-state span { color:var(--muted); }.review-footnote { margin:2rem 0; padding:1.2rem; border-top:1px solid var(--line); border-bottom:1px solid var(--line); display:grid; grid-template-columns:160px 1fr; gap:1rem; color:var(--muted); line-height:1.55; }.review-footnote>strong { color:var(--ink); }
  @media(max-width:800px){.review-guide,.candidate-grid,.decision-form { grid-template-columns:1fr; }.decision-form>* { grid-column:1; }.candidate-grid dl { grid-template-columns:1fr; }.candidate-grid dt { margin-top:.4rem; }.transcript-panel li { grid-template-columns:3.8rem 1fr; }.transcript-panel li small { grid-column:2; }.batch-heading,.review-safety { align-items:start; flex-direction:column; }.review-footnote { grid-template-columns:1fr; }}

  /* The review flow is intentionally explicit: understand, verify, decide. */
  .human-intro { max-width:760px; padding-bottom:.5rem; }
  .review-guide { margin:1.5rem 0; padding:1.25rem 1.4rem; border-radius:14px; background:var(--surface); display:grid; grid-template-columns:minmax(190px,.65fr) 1.35fr; gap:1.5rem; box-shadow:var(--shadow); }
  .review-guide h2 { margin:.25rem 0 .4rem; }
  .review-guide>div>p { margin:0; color:var(--muted); line-height:1.5; font-size:.88rem; }
  .review-guide ol { grid-template-columns:repeat(3,1fr); gap:1rem; }
  .review-guide li { align-content:start; }
  .review-guide li::before { background:var(--green); color:var(--paper); }
  .review-guide li span { display:block; margin-top:.25rem; }
  .review-safety { border-color:rgba(237,99,53,.55); border-left-color:var(--orange); background:rgba(237,99,53,.08); border-radius:10px; }
  .review-safety span { color:var(--muted); }
  .batch-heading { margin:2.2rem 0 1.1rem; padding-top:1.2rem; border-top:1px solid var(--line); align-items:end; }
  .batch-heading h2 { margin:.25rem 0 .2rem; }
  .batch-heading p { margin:0; color:var(--muted); font-size:.9rem; }
  .batch-actions { flex-wrap:wrap; justify-content:flex-end; }
  .human-review-items { gap:2rem; }
  .human-review-card { border-radius:16px; overflow:hidden; background:var(--surface); box-shadow:var(--shadow); }
  .human-review-card>header.card-header { padding:1rem 1.3rem; background:var(--paper); align-items:center; }
  .card-ident { display:flex; align-items:center; gap:.8rem; color:var(--ink); }
  .card-ident>div, .card-status { display:grid; gap:.2rem; }
  .card-ident strong, .card-status strong { font-size:.85rem; }
  .item-number { display:grid; place-items:center; width:2.2rem; height:2.2rem; margin:0; border-radius:50%; background:var(--green); color:var(--paper); }
  .card-status { text-align:right; color:var(--muted); }
  .card-status strong { color:var(--orange); }
  .review-step { padding:1.4rem clamp(1rem,3vw,1.6rem); }
  .claim-section { border-bottom:1px solid var(--line); }
  .step-heading { display:flex; gap:.75rem; align-items:flex-start; margin-bottom:1.15rem; }
  .step-heading>span { flex:0 0 1.8rem; width:1.8rem; height:1.8rem; display:grid; place-items:center; border-radius:50%; background:var(--green); color:var(--paper); font-weight:800; }
  .step-heading>div { display:grid; gap:.2rem; }
  .step-heading strong { font-size:1rem; }
  .step-heading small { color:var(--muted); line-height:1.45; }
  .claim-section h3 { margin:0; font-size:1.55rem; }
  .definition { max-width:850px; margin:.6rem 0 0; font-size:1.05rem; line-height:1.65; }
  .review-reasons { margin-top:1.2rem; padding:1rem 1.1rem; border-left:4px solid var(--line); background:var(--paper); }
  .review-reasons dl { display:grid; grid-template-columns:170px 1fr; gap:.55rem 1rem; margin:0; font-size:.84rem; }
  .review-reasons dd { margin:0; color:var(--muted); line-height:1.5; }
  .evidence-section { border-bottom:1px solid var(--line); }
  .source-summary { display:grid; grid-template-columns:minmax(0,1fr) minmax(180px,.45fr); gap:.8rem 1.2rem; padding:1rem; border:1px solid var(--line); background:var(--paper); }
  .source-details, .source-window { display:grid; align-content:start; gap:.3rem; }
  .source-details a { color:var(--ink); font-weight:750; line-height:1.4; }
  .source-details span, .source-summary p { color:var(--muted); font-size:.84rem; }
  .source-window { justify-items:start; }
  .source-window>strong { font:700 .84rem ui-monospace,monospace; }
  .source-summary>p { grid-column:1/-1; margin:.2rem 0 0; line-height:1.45; }
  .boundary-flags span { background:rgba(237,99,53,.16); color:var(--orange); }
  .boundary-flags .clear { background:rgba(23,107,69,.15); color:var(--green); }
  .transcript-panel { margin:1rem 0 0; background:var(--surface); }
  .transcript-panel>div { background:var(--paper); }
  .transcript-panel li.cited { background:rgba(237,99,53,.13); border-left-color:var(--orange); }
  .decision-section { background:var(--paper); }
  .decision-form { padding:0; grid-template-columns:1fr 1fr; }
  .decision-form select, .decision-form textarea { background:var(--surface); color:var(--ink); border-radius:6px; }
  .decision-form select:focus, .decision-form textarea:focus { outline:2px solid var(--green); outline-offset:1px; }
  .confirmations { grid-column:1/-1; margin:0; border:1px solid var(--line); border-radius:8px; background:var(--surface); }
  .confirmations legend { padding:0 .35rem; font-weight:750; }
  .confirmations label { display:flex; gap:.5rem; align-items:flex-start; line-height:1.45; }
  .confirmations input { margin-top:.2rem; }
  .decision-actions { grid-column:1/-1; padding-top:.2rem; }
  .accept-new { background:#2f6f8e; border-color:#2f6f8e; }
  .reject { background:#853d38; border-color:#853d38; }
  .keep { background:transparent; }
  .decision-reference { margin:2rem 0; padding:1.3rem 0 0; border-top:1px solid var(--line); }
  .decision-reference h2 { margin:.25rem 0 1rem; }
  .decision-reference-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:1px; border:1px solid var(--line); background:var(--line); }
  .decision-reference-grid>div { display:grid; align-content:start; gap:.35rem; min-height:85px; padding:1rem; background:var(--surface); }
  .decision-reference-grid span { color:var(--muted); font-size:.82rem; line-height:1.45; }
