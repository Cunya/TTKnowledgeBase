---
import BaseLayout from '../layouts/BaseLayout.astro';
import { existsSync, readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import corpusData from '../../public/data/kbs/table-tennis/corpus.json';
import globalCatalogData from '../data/globalttstudio-videos.json';
import sixthBatchData from '../data/tt-spinmaster-sixth-batch.json';
import progressData from '../data/generated/table-tennis-progress.json';
import type { Corpus } from '../types';

const corpus = corpusData as unknown as Corpus;
const sourceVideos = (channel: string) => corpus.videos.filter((video) => video.channel_name === channel);
const spinMasterVideos = sourceVideos('TT SpinMaster');
const globalVideos = sourceVideos('GlobalTTStudio');
const globalPublishedIds = new Set(globalVideos.map((video) => video.id));
type WorksetItem = { id: string; source_id?: string; reason: string };
type InventorySummary = { inventory: number; published: number; eligible_total?: number; eligible_complete: number; fully_processed_percent?: number; automation_triaged?: number; automation_triaged_percent?: number; automated_work_remaining: number; human_review_videos: number; retry_wait: number; excluded: number; states: Record<string, number>; availability: Record<string, number>; captions: Record<string, number>; candidates: Record<string, number> };
type SnapshotCounts = { concepts: number; videos?: number; evidence_moments: number; generated_at?: string };
const generatedProgress = progressData as { generated_at: string; totals: Record<string, number>; public_snapshot?: SnapshotCounts; quarantined_history?: { concepts: number; evidence_moments: number }; canonical_concept_files?: number; last_successful_publish_at?: string; sources: Array<Record<string, string | number>>; members_only_ids: string[]; inventory?: InventorySummary; latest_workset?: Record<string, WorksetItem[]> };
const generatedTotals = generatedProgress.totals;
const publicSnapshot = generatedProgress.public_snapshot ?? { concepts: Number(generatedTotals.concepts ?? corpus.concepts.length), videos: Number(generatedTotals.published_videos ?? corpus.videos.length), evidence_moments: Number(generatedTotals.evidence ?? 0) };
const quarantinedHistory = generatedProgress.quarantined_history ?? { concepts: 0, evidence_moments: 0 };
const inventory = generatedProgress.inventory;
const latestWorkset = generatedProgress.latest_workset ?? {};
const publishedConfiguredVideos = Number(generatedTotals.published_configured_videos ?? generatedTotals.published_videos ?? 0);
const generatedSource = (id: string) => generatedProgress.sources.find((source) => source.id === id) ?? {};
const spinMasterProgress = generatedSource('free-coach-brad-han');
const globalProgress = generatedSource('global-tt-studio');
const xiaohanProgress = generatedSource('pingsunday-xiaohan-playlist');
const globalInaccessibleIds = new Set(generatedProgress.members_only_ids);
const globalCatalogVideos = globalCatalogData.videos;
const sixthBatchVideos = sixthBatchData.videos.filter((video) => !globalPublishedIds.has(video.id) && !spinMasterVideos.some((published) => published.id === video.id));
const globalCatalogState = (id: string) => globalPublishedIds.has(id) ? 'Published' : globalInaccessibleIds.has(id) ? 'Members-only' : 'Discovered';
const globalEligibleCount = Number(globalProgress.eligible ?? globalVideos.length);
const globalInaccessibleCount = Number(globalProgress.members_only ?? globalInaccessibleIds.size);
const globalConfiguredCount = Number(globalProgress.configured ?? globalEligibleCount + globalInaccessibleCount);
const spinMasterConfiguredCount = Number(spinMasterProgress.configured ?? spinMasterVideos.length + sixthBatchVideos.length);
const totalEligibleCount = Number(generatedTotals.eligible ?? spinMasterConfiguredCount + globalEligibleCount);
const totalConfiguredCount = Number(generatedTotals.configured ?? spinMasterConfiguredCount + globalConfiguredCount);
const totalDiscoveredCount = Number(inventory?.inventory ?? generatedTotals.discovered ?? totalConfiguredCount);
const totalUnconfiguredCount = Math.max(0, totalDiscoveredCount - totalConfiguredCount);
const totalMembersOnlyCount = Math.max(0, totalConfiguredCount - totalEligibleCount);
const totalCandidateCount = Number(generatedTotals.accepted ?? 0) + Number(generatedTotals.deferred ?? 0) + Number(generatedTotals.human_review ?? 0) + Number(generatedTotals.rejected ?? 0) + Number(generatedTotals.pending ?? 0);
const publishedOutsideConfiguredCount = Math.max(0, Number(generatedTotals.published_videos ?? 0) - publishedConfiguredVideos);
const notPublicOutsideConfiguredCount = Math.max(0, totalUnconfiguredCount - publishedOutsideConfiguredCount);
const totalNotPublicCount = Math.max(0, totalDiscoveredCount - Number(generatedTotals.published_videos ?? 0));
const inventoryMembersOnlyCount = Number(inventory?.availability?.members_only ?? totalMembersOnlyCount);
const inventoryNoCaptionCount = Number(inventory?.captions?.no_usable_subtitles ?? 0);
const processedWithoutMomentsCount = Math.max(0, totalNotPublicCount - inventoryMembersOnlyCount - inventoryNoCaptionCount);
const latestWorksetCount = Object.values(latestWorkset).reduce((sum, items) => sum + (items?.length ?? 0), 0);
const percent = (value: number, total: number) => total ? Math.round((value / total) * 100) : 0;
const summaryStage = (value: number, total: number) => `${value} (${percent(value, total)}%)`;
const sourceProgress = [
  {
    name: String(xiaohanProgress.name ?? 'PingSunday — coach XiaoHan playlist'),
    detail: `${xiaohanProgress.eligible ?? 0} eligible videos`,
    stages: [
      { label: 'Configured from playlist', value: Number(xiaohanProgress.configured ?? 0), total: Number(xiaohanProgress.discovered ?? xiaohanProgress.configured ?? 0) },
      { label: 'Eligible', value: Number(xiaohanProgress.eligible ?? 0), total: Number(xiaohanProgress.configured ?? 0) },
      { label: 'Ingested', value: Number(xiaohanProgress.ingested ?? 0), total: Number(xiaohanProgress.eligible ?? 0) },
      { label: 'Extracted', value: Number(xiaohanProgress.extracted ?? 0), total: Number(xiaohanProgress.eligible ?? 0) },
      { label: 'Fully reviewed', value: Number(xiaohanProgress.reviewed ?? 0), total: Number(xiaohanProgress.eligible ?? 0) },
      { label: 'Published', value: Number(xiaohanProgress.published ?? 0), total: Number(xiaohanProgress.eligible ?? 0) },
    ],
  },
  {
    name: String(spinMasterProgress.name ?? 'TT SpinMaster'),
    detail: `${spinMasterProgress.eligible ?? spinMasterConfiguredCount} eligible videos`,
    stages: [
      { label: 'Configured from discovery', value: Number(spinMasterProgress.configured ?? spinMasterConfiguredCount), total: Number(spinMasterProgress.discovered ?? spinMasterConfiguredCount) },
      { label: 'Eligible', value: Number(spinMasterProgress.eligible ?? spinMasterConfiguredCount), total: Number(spinMasterProgress.configured ?? spinMasterConfiguredCount) },
      { label: 'Ingested', value: Number(spinMasterProgress.ingested ?? spinMasterConfiguredCount), total: Number(spinMasterProgress.eligible ?? spinMasterConfiguredCount) },
      { label: 'Extracted', value: Number(spinMasterProgress.extracted ?? spinMasterConfiguredCount), total: Number(spinMasterProgress.eligible ?? spinMasterConfiguredCount) },
      { label: 'Fully reviewed', value: Number(spinMasterProgress.reviewed ?? 0), total: Number(spinMasterProgress.eligible ?? spinMasterConfiguredCount) },
      { label: 'Published', value: Number(spinMasterProgress.published ?? spinMasterVideos.length), total: Number(spinMasterProgress.eligible ?? spinMasterConfiguredCount) },
    ],
  },
  {
    name: String(globalProgress.name ?? 'GlobalTTStudio'),
    detail: `${globalEligibleCount} eligible · ${globalInaccessibleCount} members-only`,
    stages: [
      { label: 'Configured from discovery', value: Number(globalProgress.configured ?? globalConfiguredCount), total: Number(globalProgress.discovered ?? globalConfiguredCount) },
      { label: 'Eligible', value: globalEligibleCount, total: globalConfiguredCount },
      { label: 'Ingested', value: Number(globalProgress.ingested ?? globalEligibleCount), total: globalEligibleCount },
      { label: 'Extracted', value: Number(globalProgress.extracted ?? globalEligibleCount), total: globalEligibleCount },
      { label: 'Fully reviewed', value: Number(globalProgress.reviewed ?? 0), total: globalEligibleCount },
      { label: 'Published', value: Number(globalProgress.published ?? globalEligibleCount), total: globalEligibleCount },
    ],
  },
  {
    name: 'Total configured',
    detail: `${totalEligibleCount} eligible videos`,
    stages: [
      { label: 'Configured from discovery', value: totalConfiguredCount, total: Number(generatedTotals.discovered ?? totalConfiguredCount) },
      { label: 'Eligible', value: totalEligibleCount, total: totalConfiguredCount },
      { label: 'Ingested', value: Number(generatedTotals.ingested ?? totalEligibleCount), total: totalEligibleCount },
      { label: 'Extracted', value: Number(generatedTotals.extracted ?? totalEligibleCount), total: totalEligibleCount },
      { label: 'Fully reviewed', value: Number(generatedTotals.reviewed_videos ?? 0), total: totalEligibleCount },
      { label: 'Published', value: Number(generatedTotals.published_videos ?? corpus.videos.length), total: totalEligibleCount },
    ],
  },
];

const showLocalBudget = import.meta.env.PUBLIC_PRODUCTION_BUILD !== 'true';
const budgetTaskNames = ['extraction', 'rephrase', 'benchmark'] as const;
type BudgetTaskName = (typeof budgetTaskNames)[number];
type BudgetTaskStatus = {
  usedTokens: number;
  limitTokens: number | null;
  remainingTokens: number | null;
  calls: number;
  deferred: number;
};

const budgetConfigPath = fileURLToPath(new URL('../../../config/processors.yaml', import.meta.url));
const budgetLedgerPath = fileURLToPath(new URL('../../../data/manifests/table-tennis/llm-budget.json', import.meta.url));
const budgetConfig = existsSync(budgetConfigPath) ? readFileSync(budgetConfigPath, 'utf-8') : '';
const configNumber = (pattern: RegExp, fallback: number) => {
  const match = budgetConfig.match(pattern);
  return match ? Number(match[1]) : fallback;
};
const configText = (pattern: RegExp, fallback: string) => budgetConfig.match(pattern)?.[1] ?? fallback;
const budgetEnabled = configText(/^\s+enabled:\s*(true|false)\s*$/m, 'true') === 'true';
const budgetTimezone = configText(/^\s+timezone:\s*([^\s#]+)\s*$/m, 'local');
const budgetDailyLimit = configNumber(/^\s+daily_token_limit:\s*(\d+)\s*$/m, 500000);
const taskLimit = (task: BudgetTaskName) =>
  configNumber(new RegExp(`^\\s+${task}:\\s*(\\d+)\\s*$`, 'm'), 0);
const emptyBudgetDay = { actual_tokens: 0, reserved_tokens: 0, tasks: {} as Record<string, Record<string, number>> };
const readBudgetLedger = () => {
  if (!existsSync(budgetLedgerPath)) return { days: {} as Record<string, typeof emptyBudgetDay> };
  try {
    return JSON.parse(readFileSync(budgetLedgerPath, 'utf-8')) as {
      days?: Record<string, typeof emptyBudgetDay>;
    };
  } catch {
    return { days: {} as Record<string, typeof emptyBudgetDay> };
  }
};
const budgetLedger = readBudgetLedger();
const budgetDate = new Intl.DateTimeFormat('en-CA', {
  timeZone: budgetTimezone === 'local' || budgetTimezone === 'system' ? undefined : budgetTimezone,
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(new Date());
const budgetDay = budgetLedger.days?.[budgetDate] ?? emptyBudgetDay;
const budgetUsedTokens = Number(budgetDay.actual_tokens ?? 0) + Number(budgetDay.reserved_tokens ?? 0);
const budgetRemainingTokens = Math.max(0, budgetDailyLimit - budgetUsedTokens);
const budgetPercent = budgetDailyLimit ? Math.min(100, Math.round((budgetUsedTokens / budgetDailyLimit) * 100)) : 0;
const formatTokens = (value: number) => value.toLocaleString('en-US');
const budgetTasks: Record<BudgetTaskName, BudgetTaskStatus> = Object.fromEntries(
  budgetTaskNames.map((task) => {
    const record = budgetDay.tasks?.[task] ?? {};
    const usedTokens = Number(record.actual_tokens ?? 0) + Number(record.reserved_tokens ?? 0);
    const limitTokens = taskLimit(task) || null;
    return [task, {
      usedTokens,
      limitTokens,
      remainingTokens: limitTokens === null ? null : Math.max(0, limitTokens - usedTokens),
      calls: Number(record.calls ?? 0),
      deferred: Number(record.deferred ?? 0),
    } satisfies BudgetTaskStatus];
  }),
) as Record<BudgetTaskName, BudgetTaskStatus>;
const budgetRows = budgetTaskNames.map((task) => {
  const item = budgetTasks[task];
  const limit = item.limitTokens ?? 0;
  return {
    task,
    ...item,
    taskPercent: limit ? Math.min(100, Math.round((item.usedTokens / limit) * 100)) : 0,
    progressLimit: limit || 1,
    progressValue: Math.min(item.usedTokens, limit || 1),
  };
});
const generatedDate = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long', timeStyle: 'short', timeZone: 'Europe/Helsinki' }).format(new Date(generatedProgress.generated_at));
---

<BaseLayout title="Source video progress" description="Processing progress by source for the table-tennis knowledge base.">
  <section class="page-intro progress-intro">
    <div class="eyebrow">Pipeline status · updated 16 July 2026</div>
    <h1>Source video progress</h1><p class="table-note">Snapshot: {generatedDate} EEST</p>
    <p>Discovery, transcript ingestion, Codex extraction, editorial review, and publication status for each configured table-tennis source.</p>
    <div class="progress-alert success"><strong>Published knowledge corpus</strong><span>{publicSnapshot.videos} videos with {publicSnapshot.concepts} concepts and {publicSnapshot.evidence_moments} approved evidence moments are currently available on the site.</span></div>
  </section>

  <aside class="progress-alert success"><strong>Generated snapshot</strong><span>Counts below are generated during publish from local processor artifacts. No LLM edits these project totals; the snapshot was generated at {generatedProgress.generated_at}.</span></aside>

  <section class="progress-section count-layers" aria-labelledby="count-layers-title">
    <div class="section-kicker">Count layers</div><h2 id="count-layers-title">Public content, quarantined history, and inventory are different states</h2>
    <div class="source-flow-outcomes">
      <article class="accepted"><span>Safe public snapshot</span><strong>{publicSnapshot.concepts} concepts · {publicSnapshot.videos} videos</strong><small>{publicSnapshot.evidence_moments} approved moments · last successful publish {generatedProgress.last_successful_publish_at ?? generatedProgress.generated_at}</small></article>
      <article class="deferred"><span>Quarantined history</span><strong>{quarantinedHistory.concepts} concepts</strong><small>{quarantinedHistory.evidence_moments} legacy moments retained privately for re-adjudication; not public</small></article>
      <article><span>Full inventory</span><strong>{inventory?.inventory ?? totalDiscoveredCount} videos</strong><small>{inventory?.eligible_total ?? totalEligibleCount} eligible · {inventory?.automated_work_remaining ?? 0} automated work remaining · {inventory?.excluded ?? 0} excluded</small></article>
    </div>
    <p class="source-flow-workset-note">A failed processing cycle does not create a new public snapshot. The published timestamp above remains the last complete publish until validation and publication succeed.</p>
  </section>

  <section class="progress-section">
    <div class="section-kicker">Current corpus</div><h2>Source summary</h2>
    <figure class="source-flow" aria-labelledby="source-flow-title">
      <figcaption><strong id="source-flow-title">What is on the site?</strong><span>Start here for content status. A video is “on the site” when it contributes at least one approved transcript-backed moment. Batch provenance and live run selection are separate operator concepts explained below.</span></figcaption>

      <div class="source-flow-catalog" aria-label="Known source videos split by site publication status">
        <article class="source-flow-catalog-total"><span>Known source videos</span><strong>{totalDiscoveredCount}</strong><small>all videos found in the three source inventories</small></article>
        <b>=</b>
        <div class="source-flow-catalog-groups">
          <article class="source-flow-catalog-group on-site">
            <span>On the site</span><strong>{generatedTotals.published_videos}</strong><small>videos that provide approved moments</small>
            <div class="source-flow-catalog-detail"><span><strong>{generatedTotals.evidence}</strong> approved moments</span><span><strong>{generatedTotals.concepts}</strong> concepts</span></div>
          </article>
          <b>+</b>
          <article class="source-flow-catalog-group not-on-site">
            <span>Not on the site</span><strong>{totalNotPublicCount}</strong><small>known videos that provide no public moments</small>
            <div class="source-flow-catalog-detail"><span><strong>{processedWithoutMomentsCount}</strong> processed, no approved moments</span><span><strong>{inventoryMembersOnlyCount}</strong> members-only</span><span><strong>{inventoryNoCaptionCount}</strong> no usable subtitles</span></div>
          </article>
        </div>
      </div>

      <aside class="source-flow-explainer">
        <strong>Simple content interpretation</strong>
        <p>{generatedTotals.published_videos} of the {totalDiscoveredCount} known videos currently contribute moments to the public knowledge base. The other {totalNotPublicCount} consist of {processedWithoutMomentsCount} processed videos with no approved moments, {inventoryMembersOnlyCount} members-only videos, and {inventoryNoCaptionCount} public videos without usable source subtitles.</p>
      </aside>

      {inventory && <section class="source-flow-workset" aria-labelledby="completion-ledger-title">
        <div class="source-flow-workset-heading"><span>Full-inventory ledger</span><strong id="completion-ledger-title">What work actually remains?</strong><p>These states cover all {inventory.inventory} catalog videos. “Complete” requires a usable timed transcript, current extraction, final candidate decisions, and incorporation of every accepted candidate.</p></div>
        <div class="source-flow-outcomes">
          <article class="accepted"><span>Fully processed</span><strong>{inventory.eligible_complete} / {inventory.eligible_total ?? inventory.inventory - inventory.excluded}</strong><small>{inventory.fully_processed_percent ?? 0}% of eligible inventory</small></article>
          <article><span>Codex decisions complete</span><strong>{inventory.automation_triaged ?? inventory.eligible_complete}</strong><small>fully incorporated source-grounded decisions</small></article>
          <article class="deferred"><span>Automatic work left</span><strong>{inventory.automated_work_remaining}</strong></article>
          <article><span>Optional human advisories</span><strong>{inventory.human_review_videos}</strong></article>
          <article><span>Waiting for retry</span><strong>{inventory.retry_wait}</strong></article>
          <article><span>Excluded with reason</span><strong>{inventory.excluded}</strong></article>
        </div>
        <p class="source-flow-workset-note">Latest selected batch: {latestWorksetCount} video assignments — {latestWorkset.extraction?.length ?? 0} extraction, {latestWorkset.adjudication?.length ?? 0} automatic review, and {latestWorkset.acquisition?.length ?? 0} acquisition. The private ledger, not sources.yaml membership, now determines selection.</p>
        {latestWorksetCount > 0 && <details><summary>Show latest selected video IDs and reasons</summary><div class="table-scroll"><table class="progress-table"><thead><tr><th>Stage</th><th>Source</th><th>Video</th><th>Why selected</th></tr></thead><tbody>{Object.entries(latestWorkset).flatMap(([stage, items]) => (items ?? []).map((item) => <tr><td>{stage === 'adjudication' ? 'automatic review' : stage}</td><td><code>{item.source_id ?? 'unknown source'}</code></td><td><code>{item.id}</code></td><td>{item.reason}</td></tr>))}</tbody></table></div></details>}
      </section>}

      <section class="source-flow-workset" aria-labelledby="workset-title">
        <div class="source-flow-workset-heading"><span>Operator detail</span><strong id="workset-title">How processing reached the inventory</strong><p>The 148 configured entries are accumulated batch history, not a user-selected or live batch. After those batches were exhausted, the processor continued automatically through unseen discovery-catalog videos.</p></div>
        <div class="source-flow-workset-grid">
          <article class="configured"><span>Configured batch history</span><strong>{totalConfiguredCount}</strong><small>entries accumulated in sources.yaml during controlled project batches</small><div><em><b>{publishedConfiguredVideos}</b> on the site</em><em><b>{totalMembersOnlyCount}</b> members-only</em></div></article>
          <b>+</b>
          <article class="outside"><span>Discovery-catalog continuation</span><strong>{totalUnconfiguredCount}</strong><small>catalog entries not written to sources.yaml; unseen IDs are selected dynamically</small><div><em><b>{publishedOutsideConfiguredCount}</b> on the site</em><em><b>{notPublicOutsideConfiguredCount}</b> not on the site</em></div></article>
        </div>
        <p class="source-flow-workset-note">These cards explain processing history, not current activity. Each run selects its own videos from cached stages that are missing, configured entries still needing acquisition, and unseen allowed discovery entries; it records that selection in the private run manifest.</p>
      </section>

      <div class="source-flow-subheading"><strong>Configured batch-history stages</strong><span>These counts describe only the {totalConfiguredCount} entries retained in sources.yaml, not the dynamically selected current batch.</span></div>
      <div class="source-flow-scroll">
        <ol class="source-flow-track" aria-label="Configured batch-history workflow">
          <li><span>Configured</span><strong>{totalConfiguredCount}</strong><small>videos selected into this workflow</small></li>
          <li><span>Eligible</span><strong>{totalEligibleCount}</strong><small>configured and processable</small></li>
          <li><span>Ingested</span><strong>{generatedTotals.ingested}</strong><small>normalized transcripts saved</small></li>
          <li><span>Extracted</span><strong>{generatedTotals.extracted}</strong><small>videos with candidate artifacts</small></li>
          <li><span>Published</span><strong>{publishedConfiguredVideos}</strong><small>configured videos with approved evidence</small></li>
        </ol>
      </div>

      <div class="source-flow-branches review" aria-label="Configured batch publication review states">
        <article><span>Published and fully reviewed</span><strong>{generatedTotals.reviewed_videos}</strong><p>Published configured videos with every candidate decided.</p></article>
        <article><span>Published with review backlog</span><strong>{generatedTotals.published_with_review_backlog}</strong><p>Published configured videos that still have candidates waiting for review.</p></article>
      </div>

      <div class="source-flow-lane source-flow-editorial">
        <div class="source-flow-lane-heading"><span>Full-corpus candidate review</span><strong>{totalCandidateCount} candidate proposals</strong><small>The review queue spans configured batches and discovery continuation; counts below are candidates, not videos.</small></div>
        <div class="source-flow-outcomes">
          <article class="accepted"><span>Accepted</span><strong>{generatedTotals.accepted}</strong></article>
          <article class="deferred"><span>Awaiting Codex adjudication</span><strong>{generatedTotals.deferred}</strong></article>
          <article><span>Legacy human queue</span><strong>{generatedTotals.human_review ?? 0}</strong></article>
          <article><span>Rejected</span><strong>{generatedTotals.rejected}</strong></article>
          <article><span>Pending</span><strong>{generatedTotals.pending}</strong></article>
        </div>
        <div class="source-flow-outputs">
          <article><span>Approved evidence</span><strong>{generatedTotals.evidence}</strong><small>transcript-backed moments</small></article>
          <article><span>Canonical concepts</span><strong>{generatedTotals.concepts}</strong><small>deduplicated knowledge topics</small></article>
        </div>
      </div>

      <div class="source-flow-lane source-flow-visuals">
        <div class="source-flow-lane-heading"><span>Configured-batch visual review</span><strong>{generatedTotals.visual_proposed} proposed windows → {generatedTotals.visual_verified} verified demos</strong><small>These counts cover configured entries. Spoken evidence does not automatically become a visual demonstration.</small></div>
      </div>
    </figure>
    <div class="source-flow-subheading source-flow-table-heading"><strong>Detailed source and processing metrics</strong><span>The table retains every operational count. “Configured” describes accumulated batch-history entries; “Published” in these rows describes configured entries that provide public moments.</span></div>
    <div class="table-scroll"><table class="progress-table summary-table"><thead><tr><th>Source</th><th>Discovered videos</th><th>Configured videos</th><th>Eligible videos</th><th>Ingested transcripts</th><th>Extracted candidates</th><th>Fully reviewed videos</th><th>Published videos</th><th>Accepted candidates</th><th>Rejected candidates</th><th>Evidence moments</th><th>Concepts</th><th>Visual windows proposed</th><th>Visual demos verified</th></tr></thead><tbody>
      <tr><th>TT SpinMaster<br/><small>@FreeCoachBradHan</small></th><td>{spinMasterProgress.discovered}</td><td>{summaryStage(Number(spinMasterProgress.configured), Number(spinMasterProgress.discovered))}</td><td>{summaryStage(Number(spinMasterProgress.eligible), Number(spinMasterProgress.configured))}</td><td>{summaryStage(Number(spinMasterProgress.ingested), Number(spinMasterProgress.eligible))}</td><td>{summaryStage(Number(spinMasterProgress.extracted), Number(spinMasterProgress.eligible))}</td><td>{summaryStage(Number(spinMasterProgress.reviewed), Number(spinMasterProgress.eligible))}</td><td>{summaryStage(Number(spinMasterProgress.published), Number(spinMasterProgress.eligible))}</td><td>{spinMasterProgress.accepted} + {spinMasterProgress.deferred} deferred</td><td>{spinMasterProgress.rejected}</td><td>{spinMasterProgress.evidence}</td><td>{spinMasterProgress.concepts}</td><td>{spinMasterProgress.visual_proposed}</td><td>{spinMasterProgress.visual_verified}</td></tr>
      <tr><th>GlobalTTStudio<br/><small>@GlobalTTStudio</small></th><td>{globalProgress.discovered}</td><td>{summaryStage(Number(globalProgress.configured), Number(globalProgress.discovered))}</td><td>{summaryStage(Number(globalProgress.eligible), Number(globalProgress.configured))}</td><td>{summaryStage(Number(globalProgress.ingested), Number(globalProgress.eligible))}</td><td>{summaryStage(Number(globalProgress.extracted), Number(globalProgress.eligible))}</td><td>{summaryStage(Number(globalProgress.reviewed), Number(globalProgress.eligible))}</td><td>{summaryStage(Number(globalProgress.published), Number(globalProgress.eligible))}</td><td>{globalProgress.accepted} + {globalProgress.deferred} deferred</td><td>{globalProgress.rejected}</td><td>{globalProgress.evidence}</td><td>{globalProgress.concepts}</td><td>{globalProgress.visual_proposed}</td><td>{globalProgress.visual_verified}</td></tr>
      <tr><th>PingSunday — coach XiaoHan<br/><small>playlist-only source</small></th><td>{xiaohanProgress.discovered}</td><td>{summaryStage(Number(xiaohanProgress.configured), Number(xiaohanProgress.discovered))}</td><td>{summaryStage(Number(xiaohanProgress.eligible), Number(xiaohanProgress.configured))}</td><td>{summaryStage(Number(xiaohanProgress.ingested), Number(xiaohanProgress.eligible))}</td><td>{summaryStage(Number(xiaohanProgress.extracted), Number(xiaohanProgress.eligible))}</td><td>{summaryStage(Number(xiaohanProgress.reviewed), Number(xiaohanProgress.eligible))}</td><td>{summaryStage(Number(xiaohanProgress.published), Number(xiaohanProgress.eligible))}</td><td>{xiaohanProgress.accepted} + {xiaohanProgress.deferred} deferred</td><td>{xiaohanProgress.rejected}</td><td>{xiaohanProgress.evidence}</td><td>{xiaohanProgress.concepts}</td><td>{xiaohanProgress.visual_proposed}</td><td>{xiaohanProgress.visual_verified}</td></tr>
      <tr class="total"><th>Configured batch-history total</th><td>{generatedTotals.discovered}</td><td>{summaryStage(totalConfiguredCount, Number(generatedTotals.discovered))}</td><td>{summaryStage(Number(generatedTotals.eligible), totalConfiguredCount)}</td><td>{summaryStage(Number(generatedTotals.ingested), Number(generatedTotals.eligible))}</td><td>{summaryStage(Number(generatedTotals.extracted), Number(generatedTotals.eligible))}</td><td>{summaryStage(Number(generatedTotals.reviewed_videos), Number(generatedTotals.eligible))}</td><td>{summaryStage(publishedConfiguredVideos, Number(generatedTotals.eligible))}</td><td>{generatedTotals.accepted} + {generatedTotals.deferred} deferred</td><td>{generatedTotals.rejected}</td><td>{generatedTotals.evidence}</td><td>{generatedTotals.concepts} unique</td><td>{generatedTotals.visual_proposed}</td><td>{generatedTotals.visual_verified}</td></tr>
    </tbody></table></div>
    <p class="table-note">Units differ by column: the first eight columns count videos or their processing artifacts; accepted/rejected count review-queue candidates; evidence counts approved transcript-backed moments; concepts count canonical concepts; proposed windows are candidate visual intervals; verified demos are intervals a reviewer watched and confirmed as a genuine visual demonstration. “Published” in this workflow table counts published configured videos; the public corpus contains {generatedTotals.published_videos} videos overall, including previously published material outside the current configured set.</p>
  </section>

  <section class="progress-section">
    <div class="section-kicker">Operator processing detail</div><h2>Configured batch-history progress</h2>
    <p class="progress-explainer">These percentages describe the entries accumulated in sources.yaml, not the current batch selected by run-cp.py and not the size of the public site. Configuration is measured against known source videos, eligible excludes configured members-only entries, and later stages use the eligible or previously completed stage as their denominator.</p>
    <div class="progress-groups">
      {sourceProgress.map((source) => <article class="progress-group">
        <div class="progress-group-heading"><h3>{source.name}</h3><span>{source.detail}</span></div>
        <div class="progress-bars">
          {source.stages.map((stage) => { const percentage = percent(stage.value, stage.total); return <div class="progress-item">
            <div class="progress-item-heading"><strong>{stage.label}</strong><span>{percentage}%</span></div>
            <progress max={stage.total} value={stage.value} aria-label={`${source.name}: ${stage.label} ${percentage}%`}>{percentage}%</progress>
            <small>{stage.value} / {stage.total}</small>
          </div>; })}
        </div>
      </article>)}
    </div>
  </section>

  {showLocalBudget && <section class="progress-section llm-budget-section">
    <div class="section-kicker">Local operator guard</div><h2>LLM budget</h2>
    <p class="progress-explainer">Private Codex usage for the current day. The ledger is local-only and never copied into the public corpus. Adjust the daily and task limits in <code>config/processors.yaml</code>.</p>
    {!budgetEnabled && <aside class="progress-alert warning"><strong>Budget disabled</strong><span>The daily LLM guard is disabled in the processor configuration.</span></aside>}
    <div class="llm-budget-summary">
      <div class="llm-budget-total">
        <div class="llm-budget-total-heading"><strong>{formatTokens(budgetUsedTokens)}</strong><span>of {formatTokens(budgetDailyLimit)} tokens used</span><em>{budgetPercent}%</em></div>
        <progress max={budgetDailyLimit || 1} value={Math.min(budgetUsedTokens, budgetDailyLimit || 1)} aria-label={`LLM budget ${budgetPercent}% used`}>{budgetPercent}%</progress>
        <p>{formatTokens(budgetRemainingTokens)} tokens remain for {budgetDate} ({budgetTimezone}). Reserved work is included so concurrent or interrupted runs do not overbook the allowance.</p>
      </div>
      <dl class="llm-budget-facts">
        <div><dt>Ledger</dt><dd>{existsSync(budgetLedgerPath) ? 'Active' : 'No calls recorded'}</dd></div>
        <div><dt>Scope</dt><dd>Table Tennis KB</dd></div>
        <div><dt>Source</dt><dd>Local processor manifest</dd></div>
      </dl>
    </div>
    <div class="table-scroll"><table class="progress-table llm-budget-table"><thead><tr><th>Task</th><th>Used</th><th>Limit</th><th>Remaining</th><th>Calls</th><th>Deferred</th></tr></thead><tbody>
      {budgetRows.map((item) => <tr><th><span class="llm-budget-task-name">{item.task}</span><progress max={item.progressLimit} value={item.progressValue} aria-label={`${item.task} budget ${item.taskPercent}% used`}>{item.taskPercent}%</progress></th><td>{formatTokens(item.usedTokens)}</td><td>{item.limitTokens === null ? 'Unlimited' : formatTokens(item.limitTokens)}</td><td>{item.remainingTokens === null ? 'Unlimited' : formatTokens(item.remainingTokens)}</td><td>{item.calls}</td><td>{item.deferred}</td></tr>)}
    </tbody></table></div>
    <p class="table-note">Task calls are estimated before Codex starts and reconciled with reported usage afterward. When the allowance is exhausted, extraction, rephrasing, and benchmarking are deferred rather than started.</p>
  </section>}

  <section class="progress-section">
    <div class="section-kicker">Definitions</div><h2>What each state means</h2>
    <dl class="state-definitions">
      <div><dt>Discovered</dt><dd>Metadata appeared in a channel manifest; relevance and caption availability are not guaranteed.</dd></div>
      <div><dt>Configured</dt><dd>The video is explicitly listed in the source configuration.</dd></div>
      <div><dt>Eligible</dt><dd>The configured video is selected and publicly accessible enough to process; members-only entries remain configured but are excluded from this stage.</dd></div>
      <div><dt>Ingested</dt><dd>A private normalized transcript and metadata file exist locally.</dd></div>
      <div><dt>Extracted</dt><dd>A private schema-validated Codex candidate artifact exists.</dd></div>
      <div><dt>Codex complete</dt><dd>Every extracted candidate has a final accepted or rejected semantic decision. Pending, deferred, and legacy human-assigned work are not complete.</dd></div>
      <div><dt>Published</dt><dd>At least one approved evidence moment appears in the public corpus.</dd></div>
      <div><dt>Visual verified</dt><dd>A reviewer watched the interval and confirmed it demonstrates the concept.</dd></div>
    </dl>
  </section>

  <section class="progress-section">
    <div class="section-kicker">Backlog</div><h2>Outstanding work</h2>
    <p class="table-note">Codex CLI is the default semantic adjudicator for content. Human input is optional advice or an explicit override; visual verification and rights decisions still require a person with the necessary access or authority.</p>
    <div class="table-scroll"><table class="progress-table"><thead><tr><th>Work item</th><th>Count</th><th>Owner</th><th>How to complete</th></tr></thead><tbody>
      <tr><th>Codex semantic adjudication</th><td>{generatedTotals.deferred}</td><td>Codex CLI under deterministic validators</td><td>The monitor sends bounded transcript context and a short canonical-concept list to schema-constrained Codex. Publication still requires a contiguous supported span, controlled facets, complete time bounds, and recorded model provenance.</td></tr>
      <tr><th>Optional human advisories</th><td>{generatedTotals.human_review ?? 0}</td><td>Optional editorial advisor</td><td>The local workspace may annotate or explicitly override a Codex decision when desired. It is not the default queue and does not block ordinary automated processing.</td></tr>
      <tr><th>Proposed visuals requiring viewing</th><td>{generatedTotals.visual_proposed}</td><td>Human visual reviewer</td><td>Watch each complete proposed interval from the source video. Mark it verified only when the footage genuinely demonstrates the concept; otherwise adjust or reject the visual window.</td></tr>
      <tr><th>Single-source concepts</th><td>{generatedTotals.single_source_concepts}</td><td>Source curator plus human editorial reviewer</td><td>Select an independent video that addresses the same concept, process it through ingestion and review, and add the evidence only when its transcript supports the existing claim.</td></tr>
      <tr><th>Members-only inventory videos</th><td>{inventoryMembersOnlyCount}</td><td>Human project owner or authorized rights operator</td><td>Leave these videos excluded from ordinary retries unless legitimate access and processing rights are confirmed. Their durable ledger classification persists across monitor cycles.</td></tr>
      <tr><th>Published videos with adjudication backlog</th><td>{generatedTotals.published_with_review_backlog}</td><td>Codex CLI pipeline</td><td>Process each video's deferred proposals through exact source-grounded adjudication, incorporate accepted evidence, then validate and republish the sanitized corpus.</td></tr>
      <tr><th>Automatic work still queued</th><td>{inventory?.automated_work_remaining ?? 0}</td><td>Processor monitor</td><td>Continue small cache-first cycles. The run selects missing extraction, candidates ready for Codex adjudication, and due acquisition directly from the full inventory ledger until each allowed video is complete.</td></tr>
    </tbody></table></div>
  </section>

  <section class="progress-section inventories" id="videos-by-source">
    <div class="section-kicker">Source inventory</div><h2>Videos by source</h2>
    <p class="table-note">Each source includes its complete trustworthy discovery catalog where available. State labels distinguish public knowledge-base evidence from videos that are merely listed by the channel.</p>
    <details><summary><strong>TT SpinMaster</strong><span>{spinMasterProgress.published} published / {Number(spinMasterProgress.extracted) - Number(spinMasterProgress.published)} extracted/reviewing / {spinMasterProgress.unselected} unselected</span></summary><div class="table-scroll"><table class="progress-table"><thead><tr><th>State</th><th>Video</th><th>Title</th></tr></thead><tbody>{sixthBatchVideos.map((video) => <tr><td><span class="catalog-state extracted">Extracted / review</span></td><td><a href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noreferrer"><code>{video.id}</code></a></td><td>{video.title}</td></tr>)}{spinMasterVideos.map((video) => <tr><td><span class="catalog-state published">Published</span></td><td><a href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noreferrer"><code>{video.id}</code></a></td><td>{video.title}</td></tr>)}</tbody></table></div><p class="inventory-note">Counts are generated from local processor artifacts during publish. Unselected channel discoveries have not entered the processing pipeline.</p></details>
    <details id="globalttstudio-videos"><summary><strong>GlobalTTStudio</strong><span>{globalProgress.discovered} discovered / {globalEligibleCount} published / {globalInaccessibleCount} members-only</span></summary>
      <p class="inventory-note">Metadata-only discovery on 15 July 2026. “Discovered” means listed by the channel; it does not mean selected, transcribed, extracted, or reviewed.</p>
      <div class="table-scroll"><table class="progress-table catalog-table"><thead><tr><th>State</th><th>Video</th><th>Title</th></tr></thead><tbody>{globalCatalogVideos.map((video) => <tr><td><span class:list={['catalog-state', globalCatalogState(video.id).toLowerCase()]}>{globalCatalogState(video.id)}</span></td><td><a href={video.url} target="_blank" rel="noreferrer"><code>{video.id}</code></a></td><td>{video.title}</td></tr>)}</tbody></table></div>
    </details>
  </section>
</BaseLayout>
